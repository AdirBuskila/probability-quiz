{
  "_note": "Region data for the Q1-type area items of 25S-B. RAW_SCHEMA has no `region` field, so it lives here. Ids are built question ids. Q1c is conditional (event area over conditioning area).",
  "25S-B-Q1a": {
    "sampleSpace": {"alpha1": [0, "pi"], "alpha2": [0, "pi"]},
    "distribution": "uniform on the sample space (alpha1, alpha2 independent U(0,pi))",
    "event": ["alpha2 > 2*alpha1"],
    "area": "pi^2/4", "probability": "1/4", "conditioning": null
  },
  "25S-B-Q1b": {
    "sampleSpace": {"alpha1": [0, "pi"], "alpha2": [0, "pi"]},
    "distribution": "uniform on the sample space",
    "event": ["alpha2 > alpha1 - pi/2", "alpha2 < alpha1 + pi/2"],
    "area": "3*pi^2/4", "probability": "3/4", "conditioning": null
  },
  "25S-B-Q1c": {
    "sampleSpace": {"alpha1": [0, "pi"], "alpha2": [0, "pi"]},
    "distribution": "uniform on the sample space",
    "event": ["alpha2 > alpha1 - pi/2", "alpha2 < alpha1 + pi/2"],
    "conditioning": ["alpha2 > 2*alpha1"],
    "areaEventAndConditioning": "pi^2/8", "areaConditioning": "pi^2/4", "probability": "1/2"
  }
}
